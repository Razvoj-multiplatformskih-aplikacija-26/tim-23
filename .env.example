# Razvojne vrednosti. Kopirati u .env (koji nije u git-u):  copy .env.example .env
POSTGRES_USER=kap
POSTGRES_PASSWORD=kap
POSTGRES_DB=kap
POSTGRES_PORT=5435
SERVER_PORT=8080
ADMINER_PORT=8082
# Adrese sa kojih pregledač sme da zove server (backoffice: flutter run -d chrome --web-port 8081)
CORS_ORIGINS=http://localhost:8081
# Posle koliko minuta prijava ističe
SESSION_TTL_MINUTES=480
COOKIE_SECURE=false
# Lozinka svih demo naloga (davalac1, davalac2, sestra1, koordinator1)
DEMO_PASSWORD=kap-demo
# Ključ za potpis prijava; samo na serveru, bar 32 znaka
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Lokalno vreme za početne podatke (Srbija zimi UTC+1)
SEED_UTC_OFFSET_HOURS=1
# Za server pokrenut bez Docker-a (dart run bin/server.dart)
DATABASE_URL=postgres://kap:kap@localhost:5435/kap?sslmode=disable
